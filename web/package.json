{
  "name": "group-system",
  "version": "1.0.0",
  "author": "sws",
  "private": false,
  "scripts": {
    "start": "npm run dev",
    "dev": "export NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service serve --port=8081",
    "build": "export NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build",
    "lint": "vue-cli-service lint",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "dll": "webpack --mode production --config ./webpack.dll.config.js"
  },
  "dependencies": {
    "add-asset-html-webpack-plugin": "^3.1.3",
    "axios": "^0.21.1",
    "clean-webpack-plugin": "^1.0.1",
    "clipboard": "^2.0.0",
    "codemirror": "^5.61.0",
    "countup": "^1.8.2",
    "cropperjs": "^1.2.2",
    "crypto-js": "^3.1.9-1",
    "dayjs": "^1.7.7",
    "echarts": "^4.0.4",
    "html2canvas": "^1.0.0-alpha.12",
    "iview-area": "^1.5.17",
    "js-cookie": "^2.2.0",
    "pdfobject": "^2.1.1",
    "simplemde": "^1.11.2",
    "sortablejs": "^1.7.0",
    "view-design": "^4.7.0",
    "vue": "^2.6.14",
    "vue-amap": "^0.5.8",
    "vue-i18n": "^7.8.0",
    "vue-router": "^3.0.1",
    "vuedraggable": "^2.16.0",
    "vuex": "^3.0.1",
    "wangeditor": "^3.1.1",
    "xlsx": "^0.13.3"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^3.0.1",
    "@vue/cli-plugin-eslint": "^3.0.1",
    "@vue/cli-plugin-unit-mocha": "^3.0.1",
    "@vue/cli-service": "^3.12.1",
    "@vue/eslint-config-prettier": "^4.0.1",
    "@vue/eslint-config-standard": "^3.0.0-beta.10",
    "@vue/test-utils": "^1.0.0-beta.10",
    "chai": "^4.1.2",
    "compression-webpack-plugin": "^2.0.0",
    "eslint-plugin-cypress": "^2.0.1",
    "less": "^2.7.3",
    "less-loader": "^4.0.5",
    "lint-staged": "^6.0.0",
    "mockjs": "^1.0.1-beta3",
    "uglifyjs-webpack-plugin": "^2.1.3",
    "vue-template-compiler": "^2.6.14",
    "webpack-bundle-analyzer": "^3.3.2",
    "webpack-cli": "^3.3.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "vue-cli-service lint",
      "git add"
    ],
    "*.vue": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "description": "",
  "main": ".eslintrc.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "license": "ISC",
  "extends": [
    "plugin:vue/essential",
    "eslint:recommended",
    "@vue/prettier"
  ]
}
